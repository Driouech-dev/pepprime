---
import type { Product } from '../data/products';

interface Props {
  product: Product;
}

const { product } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<article data-product-card data-product-name={product.name.toLowerCase()} class="group overflow-hidden rounded-[1.75rem] border border-brand-border bg-brand-surface/90 shadow-soft transition-all duration-300 hover:-translate-y-1 hover:shadow-glow">
  <a href={`${base}products/${product.slug}/`} class="block aspect-[4/3] overflow-hidden bg-slate-900/50">
    <img
      src={product.image}
      alt={product.name}
      class="h-full w-full object-cover transition duration-500 group-hover:scale-[1.03]"
    />
  </a>

  <div class="p-5 sm:p-6">
    <div class="flex flex-wrap items-start justify-between gap-3">
      <div>
        <div class="label-pill text-[11px]">{product.category}</div>
        <h3 class="mt-3 text-xl font-semibold text-white">
          <a href={`${base}products/${product.slug}/`}>{product.name}</a>
        </h3>
      </div>

      <div class="rounded-full bg-brand-blue/15 px-3 py-1 text-sm font-semibold text-blue-100 transition-all duration-300 group-hover:bg-brand-blue group-hover:text-white">
        {product.price}
      </div>
    </div>

    <p class="mt-3 text-sm leading-7 text-brand-muted">{product.shortDescription}</p>
    <div class="mt-4 text-sm text-brand-dim">{product.size}</div>

    <div class="mt-5 flex flex-col gap-3 sm:flex-row">
      <a
        href={`${base}products/${product.slug}/`}
        class="rounded-full bg-white px-4 py-3 text-center text-sm font-semibold text-brand-midnight transition-all duration-300 hover:-translate-y-0.5 hover:bg-blue-50"
        data-i18n="common.viewDetails"
      >
        View Details
      </a>

      <a
        href={`${base}contact/`}
        class="rounded-full border border-brand-border bg-white/5 px-4 py-3 text-center text-sm font-semibold text-white transition-all duration-300 hover:-translate-y-0.5 hover:bg-white/10"
        data-i18n="common.requestQuote"
      >
        Request Quote
      </a>
    </div>
  </div>
</article>
