---
const base = import.meta.env.BASE_URL;
---

<section class="relative overflow-hidden border-b border-white/5 bg-hero-glow">
  <div class="absolute inset-0 soft-grid opacity-30 [mask-image:linear-gradient(to_bottom,white,transparent_82%)]"></div>
  <div class="relative mx-auto grid max-w-7xl gap-10 px-4 py-14 sm:px-6 sm:py-18 lg:grid-cols-[0.95fr_1.05fr] lg:items-center lg:py-24">
    <div>
      <div class="label-pill inline-flex" data-i18n="home.badge">pepprime • Premium Research Peptides</div>

      <h1 class="mt-5 max-w-3xl text-4xl font-semibold tracking-tight text-white sm:text-5xl lg:text-6xl" data-i18n="home.title">
        Research peptide presentation with visible pricing, laboratory credibility, and direct global inquiry.
      </h1>

      <p class="mt-6 max-w-2xl text-base leading-8 text-brand-muted sm:text-lg" data-i18n="home.subtitle">
        pepprime combines product visibility, research-focused branding, and fast communication to create a cleaner sourcing experience for peptide customers on desktop and phone.
      </p>

      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <a href={`${base}products/`} class="rounded-full bg-brand-blue px-6 py-3.5 text-center text-sm font-semibold text-white shadow-glow transition-all duration-300 hover:-translate-y-0.5 hover:bg-sky-500" data-i18n="home.btnProducts">
          View Products
        </a>
        <a href={`${base}contact/`} class="rounded-full border border-brand-border bg-white/5 px-6 py-3.5 text-center text-sm font-semibold text-white transition-all duration-300 hover:-translate-y-0.5 hover:bg-white/10" data-i18n="home.btnContact">
          Contact Us
        </a>
      </div>

      <div class="mt-10 grid gap-4 sm:grid-cols-3">
        <div class="rounded-3xl border border-brand-border bg-white/5 p-4 shadow-soft transition-all duration-300 hover:-translate-y-1 hover:shadow-glow">
          <div class="text-2xl font-semibold text-white">21+</div>
          <div class="mt-1 text-sm text-brand-muted" data-i18n="home.statProductsLabel">Research products currently listed</div>
        </div>
        <div class="rounded-3xl border border-brand-border bg-white/5 p-4 shadow-soft transition-all duration-300 hover:-translate-y-1 hover:shadow-glow">
          <div class="text-2xl font-semibold text-white" data-i18n="home.statWorldwide">Worldwide</div>
          <div class="mt-1 text-sm text-brand-muted" data-i18n="home.statWorldwideLabel">Direct WhatsApp and email inquiry support</div>
        </div>
        <div class="rounded-3xl border border-brand-border bg-white/5 p-4 shadow-soft transition-all duration-300 hover:-translate-y-1 hover:shadow-glow">
          <div class="text-2xl font-semibold text-white" data-i18n="home.statMobile">Mobile Ready</div>
          <div class="mt-1 text-sm text-brand-muted" data-i18n="home.statMobileLabel">Built to display clearly on desktop, Android, and iPhone</div>
        </div>
      </div>
    </div>

    <div class="grid gap-4 lg:grid-cols-[1fr_0.9fr] lg:grid-rows-[1fr_1fr]">
      <div
        class="relative overflow-hidden rounded-[2rem] border border-brand-border shadow-soft transition-all duration-300 hover:-translate-y-1 hover:shadow-glow lg:row-span-2"
        role="img"
        aria-label="Pepprime production environment"
        style={`background-image: linear-gradient(180deg, rgba(2,6,23,0.18), rgba(2,6,23,0.78)), url('${base}images/facility-production.jpg'); background-size: cover; background-position: center;`}
      >
        <div class="h-full min-h-[320px] w-full"></div>
        <div class="absolute inset-x-0 bottom-0 p-6 sm:p-8">
          <div class="label-pill" data-i18n="home.productionEyebrow">Manufacturing presentation</div>
          <h2 class="mt-4 text-3xl font-semibold tracking-tight text-white" data-i18n="home.productionTitle">Production environment</h2>
          <p class="mt-3 max-w-md text-sm leading-7 text-blue-50/85" data-i18n="home.productionCopy">
            A darker premium layout supported by facility visuals, product clarity, and consistent biotech branding.
          </p>
        </div>
      </div>

      <div
        class="relative overflow-hidden rounded-[2rem] border border-brand-border shadow-soft transition-all duration-300 hover:-translate-y-1 hover:shadow-glow"
        role="img"
        aria-label="Reliable delivery support"
        style={`background-image: linear-gradient(180deg, rgba(2,6,23,0.18), rgba(2,6,23,0.74)), url('${base}images/shipping-team.png'); background-size: cover; background-position: center;`}
      >
        <div class="h-44 w-full sm:h-52"></div>
        <div class="absolute inset-x-0 bottom-0 p-5">
          <div class="text-sm font-semibold uppercase tracking-[0.18em] text-sky-300" data-i18n="home.deliveryEyebrow">Reliable delivery support</div>
          <div class="mt-2 text-xl font-semibold text-white" data-i18n="home.deliveryTitle">Fast worldwide communication</div>
        </div>
      </div>

      <div
        class="relative overflow-hidden rounded-[2rem] border border-brand-border shadow-soft transition-all duration-300 hover:-translate-y-1 hover:shadow-glow"
        role="img"
        aria-label="Research-driven visual identity"
        style={`background-image: linear-gradient(180deg, rgba(2,6,23,0.18), rgba(2,6,23,0.74)), url('${base}images/lab-scientist.png'); background-size: cover; background-position: center;`}
      >
        <div class="h-44 w-full sm:h-52"></div>
        <div class="absolute inset-x-0 bottom-0 p-5">
          <div class="text-sm font-semibold uppercase tracking-[0.18em] text-sky-300" data-i18n="home.researchEyebrow">Research-driven visual identity</div>
          <div class="mt-2 text-xl font-semibold text-white" data-i18n="home.researchTitle">Laboratory-focused branding</div>
        </div>
      </div>
    </div>
  </div>
</section>
