---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="pepprime | Track Your Order" description="Track your order with pepprime.">
  <section class="mx-auto max-w-4xl px-4 py-14 sm:px-6 sm:py-16 prose-policy">
    <div class="label-pill">Support</div>
    <h1 class="mt-4 text-4xl font-semibold tracking-tight text-white">Track Your Order</h1>
    <p class="mt-4">To check order status, contact pepprime directly with your order information.</p>
    <h2 class="mt-8 text-2xl font-semibold">Please include</h2>
    <ul>
      <li>Your name</li>
      <li>Order reference or invoice number</li>
      <li>Product name</li>
      <li>Order date</li>
      <li>Destination country</li>
    </ul>
    <h2 class="mt-8 text-2xl font-semibold">Contact Options</h2>
    <p>Email: info@pepprime.com</p>
    <p>WhatsApp: +8615102940126</p>
  </section>
</BaseLayout>
