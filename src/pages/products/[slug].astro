---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { products } from '../../data/products';

export async function getStaticPaths() {
  return products.map((product) => ({
    params: { slug: product.slug },
    props: {
      product,
      related: products.filter((item) => item.slug !== product.slug).slice(0, 3)
    }
  }));
}

const { product, related } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<BaseLayout title={`pepprime | ${product.name}`} description={product.shortDescription}>
  <section class="mx-auto max-w-7xl px-4 py-14 sm:px-6 sm:py-16">
    <div class="mb-6 text-sm text-brand-dim">
      <a href={`${base}products/`} class="transition hover:text-white" data-i18n="nav.products">Products</a>
      <span class="mx-2">/</span>
      <span class="text-brand-muted">{product.name}</span>
    </div>

    <div class="grid gap-8 lg:grid-cols-[1.02fr_0.98fr] lg:gap-10">
      <div class="overflow-hidden rounded-[2rem] border border-brand-border bg-brand-surface/90 shadow-soft">
        <div class="aspect-[4/3] bg-slate-950/50">
          <img src={product.image} alt={product.name} class="h-full w-full object-cover" />
        </div>
      </div>

      <div>
        <div class="inline-flex rounded-full border border-brand-border bg-brand-blue/10 px-3 py-1 text-xs font-semibold uppercase tracking-[0.18em] text-sky-200">
          {product.category}
        </div>

        <h1 class="mt-4 text-4xl font-semibold tracking-tight text-white">{product.name}</h1>
        <p class="mt-4 text-base leading-8 text-brand-muted sm:text-lg">{product.shortDescription}</p>

        <div class="mt-6 grid gap-4 sm:grid-cols-2">
          <div class="rounded-[1.5rem] border border-brand-border bg-brand-surface/90 p-5 shadow-soft">
            <div class="text-xs uppercase tracking-[0.2em] text-brand-dim" data-i18n="product.price">Price</div>
            <div class="mt-2 text-lg font-semibold text-white">{product.price}</div>
          </div>
          <div class="rounded-[1.5rem] border border-brand-border bg-brand-surface/90 p-5 shadow-soft">
            <div class="text-xs uppercase tracking-[0.2em] text-brand-dim" data-i18n="product.format">Format</div>
            <div class="mt-2 text-sm font-semibold text-white">{product.size}</div>
          </div>
        </div>

        <div class="mt-6 flex flex-col gap-3 sm:flex-row">
          <a
            href={`${base}contact/`}
            class="rounded-full bg-brand-blue px-6 py-3.5 text-center text-sm font-semibold text-white shadow-glow transition hover:bg-sky-500"
            data-i18n="common.requestQuote"
          >
            Request Quote
          </a>

          <a
            href="https://wa.me/8615102940126"
            target="_blank"
            rel="noreferrer"
            class="rounded-full border border-brand-border bg-white/5 px-6 py-3.5 text-center text-sm font-semibold text-white transition hover:bg-white/10"
            data-i18n="mobile.whatsapp"
          >
            WhatsApp
          </a>
        </div>

        <div class="mt-8 rounded-[2rem] border border-brand-border bg-brand-surface/90 p-6 shadow-soft">
          <h2 class="text-xl font-semibold text-white" data-i18n="product.highlights">Product highlights</h2>
          <ul class="mt-5 space-y-3 text-sm leading-7 text-brand-muted">
            {product.details.map((item: string) => <li>• {item}</li>)}
          </ul>
        </div>
      </div>
    </div>

    <div class="mt-14">
      <div class="mb-6 flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <div class="text-sm font-semibold uppercase tracking-[0.18em] text-sky-300" data-i18n="product.relatedEyebrow">Related items</div>
          <h2 class="mt-2 text-3xl font-semibold tracking-tight text-white" data-i18n="product.moreProducts">More products</h2>
        </div>

        <a href={`${base}products/`} class="text-sm font-semibold text-sky-300 transition hover:text-white" data-i18n="product.backAll">
          Back to all products
        </a>
      </div>

      <div class="grid gap-6 md:grid-cols-2 xl:grid-cols-3">
        {related.map((item) => (
          <a
            href={`${base}products/${item.slug}/`}
            class="overflow-hidden rounded-[1.75rem] border border-brand-border bg-brand-surface/90 shadow-soft transition hover:-translate-y-1 hover:shadow-glow"
          >
            <div class="aspect-[4/3] overflow-hidden bg-slate-950/50">
              <img src={item.image} alt={item.name} class="h-full w-full object-cover" />
            </div>

            <div class="p-5">
              <div class="text-[11px] font-semibold uppercase tracking-[0.2em] text-sky-300">{item.category}</div>
              <h3 class="mt-2 text-xl font-semibold text-white">{item.name}</h3>
              <div class="mt-2 text-sm font-semibold text-sky-200">{item.price}</div>
              <p class="mt-3 text-sm leading-7 text-brand-muted">{item.shortDescription}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
