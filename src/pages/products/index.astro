---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductCard from '../../components/ProductCard.astro';
import { products } from '../../data/products';
const base = import.meta.env.BASE_URL;
---

<BaseLayout
  title="pepprime | Products"
  description="Browse the current pepprime peptide catalog with visible pricing and direct inquiry contact."
>
  <section class="mx-auto max-w-7xl px-4 py-14 sm:px-6 sm:py-16">
    <div class="max-w-3xl">
      <div class="label-pill" data-i18n="products.badge">Products</div>
      <h1 class="mt-4 text-4xl font-semibold tracking-tight text-white sm:text-5xl" data-i18n="products.title">
        Current peptide catalog
      </h1>
      <p class="mt-5 text-base leading-8 text-brand-muted sm:text-lg" data-i18n="products.intro">
        Explore the current pepprime product range with visible pricing, clean product presentation, and direct inquiry by email or WhatsApp.
      </p>
    </div>

    <div class="mt-8 max-w-2xl rounded-[1.5rem] border border-brand-border bg-brand-surface/80 p-4 shadow-soft sm:p-5">
      <label
        for="product-search"
        class="mb-2 block text-sm font-semibold text-white"
        data-i18n="products.searchLabel"
      >
        Search products
      </label>

      <input
        id="product-search"
        type="search"
        placeholder="Type a product name"
        data-i18n-placeholder="products.searchPlaceholder"
        class="w-full rounded-2xl border border-brand-border bg-white/5 px-4 py-3 text-sm text-white outline-none transition placeholder:text-brand-dim focus:border-sky-400 focus:bg-white/10"
      />
    </div>

    <p
      data-product-no-results
      class="mt-6 hidden rounded-2xl border border-brand-border bg-white/5 px-4 py-3 text-sm text-brand-muted"
      data-i18n="products.noResults"
    >
      No products matched that name.
    </p>

    <div data-product-grid class="mt-10 grid gap-6 md:grid-cols-2 xl:grid-cols-3">
      {products.map((product) => (
        <div data-product-card data-product-name={product.name.toLowerCase()}>
          <ProductCard product={product} />
        </div>
      ))}
    </div>

    <script is:inline>
      (() => {
        const input = document.getElementById('product-search');
        const cards = Array.from(document.querySelectorAll('[data-product-card]'));
        const noResults = document.querySelector('[data-product-no-results]');

        if (!input || !cards.length) return;

        const filterCards = () => {
          const query = input.value.trim().toLowerCase();
          let visibleCount = 0;

          cards.forEach((card) => {
            const name = (card.getAttribute('data-product-name') || '').toLowerCase();
            const show = !query || name.includes(query);

            card.classList.toggle('hidden', !show);

            if (show) visibleCount += 1;
          });

          if (noResults) {
            noResults.classList.toggle('hidden', visibleCount !== 0);
          }
        };

        input.addEventListener('input', filterCards);
      })();
    </script>
  </section>
</BaseLayout>
