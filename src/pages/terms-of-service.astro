---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="pepprime | Terms of Service" description="Terms of service for pepprime website.">
  <section class="mx-auto max-w-4xl px-4 py-14 sm:px-6 sm:py-16 prose-policy">
    <div class="label-pill">Policy</div>
    <h1 class="mt-4 text-4xl font-semibold tracking-tight text-white">Terms of Service</h1>
    <p class="mt-4">Effective date: [Insert date]</p>
    <p>By using the pepprime website, you agree to these terms.</p>
    <h2 class="mt-8 text-2xl font-semibold">Website Use</h2>
    <p>The website is provided for informational and business communication purposes. You agree to use it lawfully and in a way that does not interfere with website operations.</p>
    <h2 class="mt-8 text-2xl font-semibold">Product Information</h2>
    <p>We aim to present product information clearly, but product availability, pricing, and descriptions may change without notice.</p>
    <h2 class="mt-8 text-2xl font-semibold">Research Use Notice</h2>
    <p>Any products described on this website are presented for research-related inquiry where applicable. Customers are responsible for ensuring compliance with local laws and requirements.</p>
    <h2 class="mt-8 text-2xl font-semibold">Limitation of Liability</h2>
    <p>To the extent permitted by law, pepprime is not liable for indirect or consequential damages arising from website use, shipping delays, third-party services, or communication delays.</p>
  </section>
</BaseLayout>
