---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileActionBar from '../components/MobileActionBar.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'pepprime | Molecular Innovation',
  description = 'Research peptide catalog with visible pricing, modern manufacturing presentation, and direct inquiry support.'
} = Astro.props;

const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/jpeg" href={`${base}images/logo.jpg`} />
  </head>
  <body class="min-h-screen bg-brand-midnight text-brand-text antialiased pb-20 md:pb-0">
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <MobileActionBar />
    <script src={`${base}i18n.js`} defer></script>
  </body>
</html>
